## App.js (main entry)

```javascript
import React, {useEffect, useState, useRef} from 'react';
import { SafeAreaView, View, Text, TouchableOpacity, FlatList, Image, Alert, StyleSheet } from 'react-native';
import AsyncStorage from '@react-native-async-storage/async-storage';
import io from 'socket.io-client';
import PlayerCard from './components/PlayerCard';
import SkillTree from './components/SkillTree';
import { apiFetch } from './lib/api';

const CONFIG = {
  SOCKET_SERVER: 'https://your-server.example.com',
  API_BASE: 'https://your-server.example.com/api',
  ASSET_PATH: 'assets/'
};

const STARTING_STATE = {
  player: {
    id: null,
    name: 'Ash', level: 1, xp: 0, xpToNext: 100, statPoints: 0,
    stats: { strength:5, agility:5, intelligence:5, vitality:5 },
    hp:100, mp:30, inventory: [], equipped: { weapon:null, armor:null }, skills: []
  },
  quests:[{id:1, title:'Clear the Goblin Camp', xp:40, status:'available'}],
  log: []
};

export default function App(){
  const [state, setState] = useState(STARTING_STATE);
  const socketRef = useRef(null);

  useEffect(()=>{
    (async ()=>{
      const raw = await AsyncStorage.getItem('solo-state');
      if(raw) setState(JSON.parse(raw));
    })();
  },[]);

  useEffect(()=>{
    AsyncStorage.setItem('solo-state', JSON.stringify(state));
  },[state]);

  useEffect(()=>{
    try{
      const socket = io(CONFIG.SOCKET_SERVER, { autoConnect:true });
      socketRef.current = socket;
      socket.on('connect', ()=> console.log('socket connected', socket.id));
      socket.on('player:update', payload => console.log('player update', payload));
      return ()=> socket.disconnect();
    }catch(e){console.warn(e)}
  },[]);

  function pushLog(text){
    setState(s=> ({...s, log:[{time:Date.now(), text}, ...s.log].slice(0,200)}));
  }

  function gainXP(amount, source=''){
    setState(s=>{
      const p = {...s.player};
      p.xp += amount;
      pushLog(`${amount} XP gained ${source}`);
      while(p.xp >= p.xpToNext){
        p.xp -= p.xpToNext; p.level +=1; p.statPoints +=3; p.xpToNext = Math.round(p.xpToNext*1.25);
        pushLog(`Leveled to ${p.level}`);
      }
      return {...s, player:p};
    });
  }

  function addItem(item){ setState(s=>({...s, player:{...s.player, inventory:[...s.player.inventory, item]}})); pushLog(`Got ${item}`); }

  return (
    <SafeAreaView style={styles.container}>
      <View style={{flex:1}}>
        <PlayerCard player={state.player} onTrain={()=>gainXP(15,'Training')} />
        <View style={{flex:1, padding:12}}>
          <SkillTree player={state.player} onLearn={(id)=>{ /* allocate via state update */
            setState(s=>{
              const p = {...s.player};
              if(p.statPoints<=0) return s;
              const found = p.skills.find(x=>x.id===id);
              if(found) { if(found.level<5) found.level+=1; } else p.skills.push({id, level:1});
              p.statPoints -=1; return {...s, player:p};
            });
          }} />

          <View style={{marginTop:12}}>
            <Text style={{color:'#ddd', marginBottom:6}}>Inventory</Text>
            <FlatList data={state.player.inventory} keyExtractor={(i,idx)=>i+idx} horizontal renderItem={({item})=> (
              <View style={styles.itemBox}><Text style={{color:'#fff'}}>{item}</Text></View>
            )} />
          </View>
        </View>
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({ container:{flex:1, backgroundColor:'#0b1020'}, itemBox:{padding:8, backgroundColor:'#111827', marginRight:8, borderRadius:8}});
```

